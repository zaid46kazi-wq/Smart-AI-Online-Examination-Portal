{
  "name": "online-exam-system",
  "version": "3.1.0",
  "description": "AI-Powered Online Examination System — Express + MySQL 8 + React + Vite",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "init-db": "node database/init_db.js",
    "test": "node --test backend/tests/integration.test.js",
    "test:backend": "node --test backend/tests/integration.test.js",
    "check": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0"
  },
  "keywords": ["exam", "online", "proctoring", "ai", "react", "vite", "mysql"],
  "author": "Sayed Zaid Kazi",
  "license": "ISC"
}
